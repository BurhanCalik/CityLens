# ============================================================
# CityLens — environment template. Copy to .env and fill in.
# NEVER commit the real .env (it is gitignored).
# ============================================================

# --- Google Street View Static API (SERVER-SIDE ONLY) ---
# Used by ml/fetch.py. Keep secret. Do NOT prefix with NEXT_PUBLIC_.
GOOGLE_MAPS_API_KEY=your_streetview_static_api_key_here

# --- Cursor SDK / CLI bonus automation ---
# Used by tools/cursor/summarize_detections.mjs to create docs/REPORT.md.
CURSOR_API_KEY=cursor_your_user_api_key_here

# --- Web (Next.js) — values exposed to the browser ---
# Backend base URL that the web app calls for GET /detections.
# Local dev: http://localhost:8080  | Prod: https://<your-app>.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8080
# OPTIONAL restricted (HTTP-referrer locked) browser key, only if you switch
# the basemap to Google tiles. The free OSM basemap needs no key.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Backend (Go / masterfabric architecture) ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
# OPTIONAL: absolute/relative path to a detections.json on disk.
# If empty, the backend serves the embedded (baked-in) detections.json.
DETECTIONS_PATH=
LOG_LEVEL=info
LOG_FORMAT=json
